# RootQuest SAT environment variables.
# Copy to .env.local for local development. All values have safe dev defaults,
# but JWT_SECRET MUST be set to a long random string in production.

# Secret used to sign session tokens (required in production).
JWT_SECRET=change-me-to-a-long-random-string

# Path to the SQLite database file (created and migrated automatically).
DATABASE_PATH=.data/rootquest.sqlite

# Public base URL of the app (used in emails/links).
APP_URL=http://localhost:3000
